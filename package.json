{
  "name": "angel",
  "version": "0.1.0",
  "description": "Multi-agent system for reviewing GitHub pull requests and issues, built on LangGraph",
  "license": "BSD-3-Clause",
  "author": "Kaíque Kandy Koga <kaiquekandykoga@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiquekandykoga/angel.git"
  },
  "keywords": [
    "langgraph",
    "agent",
    "code-review",
    "github-app",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "angel": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "angel": "tsx src/bin.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.10",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts"
}
