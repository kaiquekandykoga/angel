# Get a key from https://build.nvidia.com
ANGEL_NVIDIA_API_KEY=

# GitHub App installed on the target repositories, with Pull requests: read,
# Issues: read and write (comments and the `angel` label), and Metadata: read
ANGEL_GITHUB_APP_ID=

# Path to the GitHub App's private key .pem file
ANGEL_GITHUB_PRIVATE_KEY_PATH=

# Optional. Output token ceiling for one model call, default 32768. The model reasons
# before it answers and those tokens count too, so a ceiling sized to the review alone
# truncates the JSON mid-object and loses the item.
ANGEL_NVIDIA_MAX_COMPLETION_TOKENS=

# Optional. Console color: auto (default, color only when the stream is a terminal),
# always (keep color when piping or redirecting), never. A non-empty NO_COLOR wins
# over any value set here.
ANGEL_COLOR=

# Only for `npm run eval` — a Langfuse project's keys, from https://cloud.langfuse.com
# or your own instance. See docs/EVAL.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional. Langfuse instance, default https://cloud.langfuse.com
LANGFUSE_BASE_URL=
