# Get a key from https://build.nvidia.com
NISHIKIHEBI_NVIDIA_API_KEY=

# GitHub App with read access to pull requests and write access to issue comments,
# installed on the target repositories
NISHIKIHEBI_GITHUB_APP_ID=

# Path to the GitHub App's private key .pem file
NISHIKIHEBI_GITHUB_PRIVATE_KEY_PATH=
